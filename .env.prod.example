# Copie para .env.prod e preencha com valores reais. NUNCA commitar o .env.prod (já está no
# .gitignore da pasta raiz — confirme antes de subir para o servidor).

# --- Banco / fila ---
POSTGRES_USER=proptech
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=proptech
# Porta do Postgres — usada pelo backend internamente (rede do compose) E publicada em
# 127.0.0.1:<esta porta> no próprio servidor (só loopback, nunca 0.0.0.0/internet — dá pra
# conectar com psql/DBeaver via túnel SSH pra inspecionar o banco, mas ninguém de fora alcança).
# Padrão 55432 (em vez do 5432 óbvio) evita qualquer colisão com outro Postgres já rodando no
# servidor, mesmo que ele também publique porta ao host.
POSTGRES_INTERNAL_PORT=55432

# --- Segredos da aplicação ---
# Gerar com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-valor-aleatorio-de-32-bytes-ou-mais
# Gerar com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=troque-por-uma-chave-fernet-valida

# --- Domínio (sem domínio ainda: deixe como está, acesso será só por IP:porta) ---
PLATFORM_DOMAIN=localhost

# --- Mercado Pago (opcional — deixe em branco se ainda não configurado) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Observabilidade (opcional) ---
SENTRY_DSN=

# --- Painel da plataforma (007-superadmin) — conta fora do modelo de tenant ---
# Provisionada automaticamente no primeiro start (idempotente). Deixe em branco para não criar
# a conta (painel em /admin/login fica inacessível até preencher e reiniciar o backend).
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Integração com portais (009-integracao-portais) — deixe em branco até ter os dados reais ---
# E-mail de contato exibido no Header do feed VRSync (publicação de anúncios no ZAP/Viva Real).
CANAL_PRO_FEED_EMAIL=
# SECRET_KEY única do sistema, obtida junto ao Grupo OLX no processo de homologação do CRM —
# não é por tenant. Sem ela, o webhook de recebimento de leads dos portais (POST
# /webhooks/leads/portais) rejeita tudo com 401 (a publicação do feed funciona sem essa chave).
CANAL_PRO_WEBHOOK_SECRET=

# --- Portas publicadas no host — AJUSTE se colidirem com outro serviço já rodando no servidor ---
# Antes de subir, confira com: ss -tlnp (ou netstat -tlnp) no servidor.
BACKEND_PORT=8001
FRONTEND_PORT=8090
